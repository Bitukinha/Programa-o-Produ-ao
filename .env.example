DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: override the shared PCP login password (default: Mudar@123)
# PCP_PASSWORD="Mudar@123"

# Optional: override the shared Qualidade login password (default: Mudar@123)
# QUALIDADE_PASSWORD="Mudar@123"

# Optional: secret used to sign the session cookie (min 32 chars).
# Set this in production so sessions can be invalidated on demand.
# SESSION_SECRET="change-me-to-a-random-32-plus-character-string"
